<?xml version="1.0" encoding="utf-8"?>
<!--
  KioskNav: the stock firmware has no SystemUI, so there is no navigation bar or gesture handling.
  This accessibility service draws a thin strip along the bottom edge; swiping up from it shows a
  Back / Home bar. Runs independently of Kiosk Satellite so it works when the kiosk crashes.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.kioskclock.nav"
    android:versionCode="28"
    android:versionName="1.1.2">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />

    <!-- Granted to preinstalled apps: brightness and auto-brightness. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Quick panel: Bluetooth toggle, Wi-Fi state, and ClockBridge's privileged actions. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="org.kioskclock.permission.CONTROL" />
    <!-- Clock settings screen (Settings.Global keys). Development permission: ClockBridge grants it at boot. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Media controls: read and control every app's media session (privileged; Android Go has no
         notification listeners, the usual route). KioskNav lives in /product/priv-app for this. -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <!-- Bluetooth speaker tile: become discoverable without the confirmation dialog (privileged). -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">


        <service android:name=".NavService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/nav_service" />
        </service>

        <!-- Settings → Display → Brightness level starts this (SystemUI's dialog on stock Android). -->
        <activity android:name=".BrightnessActivity"
            android:label="Brightness"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.intent.action.SHOW_BRIGHTNESS_DIALOG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
