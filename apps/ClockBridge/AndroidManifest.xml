<?xml version="1.0" encoding="utf-8"?>
<!--
  ClockBridge: system helper for the Lenovo Smart Clock 2 kiosk ROM.
  - (The mic anchor lives in ClockCore, the only persistent app; ClockBridge updates over the network.)
  - Dock: night light + phone charging state via Lenovo's charge_base service (whitelisted calls only).
  - Small token-protected HTTP API for Home Assistant, advertised via mDNS as _kioskclock._tcp.
  - One-time first-boot provisioning (enables KioskNav) when WRITE_SECURE_SETTINGS is held.
  In the ROM it lives in /product/priv-app (privileged, NOT persistent): it starts at boot and after
  its own updates, and newer releases install over it from GitHub (OwnUpdater).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.kioskclock.bridge"
    android:versionCode="14"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Privileged: silent Kiosk Satellite updates (granted via privapp-permissions in the ROM). -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <!-- Privileged: first-boot setup (Kiosk home entry, disabling stock apps, time zone). -->
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <uses-permission android:name="android.permission.SET_TIME_ZONE" />
    <!-- Privileged: "Restart" in the KioskNav quick panel. -->
    <uses-permission android:name="android.permission.REBOOT" />
    <!-- Privileged: lets ClockBridge be the package verifier (VerifierReceiver). -->
    <uses-permission android:name="android.permission.PACKAGE_VERIFICATION_AGENT" />
    <!-- Granted to the package verifier (not privileged, so no allowlist entry): Kiosk's special access. -->
    <uses-permission android:name="android.permission.MANAGE_APP_OPS_MODES" />
    <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
    <!-- Granted to preinstalled apps: system settings (24 h clock, brightness). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Only apps signed with the project key (KioskNav) may send quick-panel commands. -->
    <uses-permission android:name="org.kioskclock.permission.CONTROL" />
    <permission android:name="org.kioskclock.permission.CONTROL"
        android:protectionLevel="signature" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:directBootAware="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:usesNonSdkApi="true">

        <service android:name=".BridgeService"
            android:exported="false"
            android:directBootAware="true" />

        <receiver android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".InstallResultReceiver"
            android:exported="false" />

        <receiver android:name=".ControlReceiver"
            android:exported="true"
            android:permission="org.kioskclock.permission.CONTROL">
            <intent-filter>
                <action android:name="org.kioskclock.bridge.CONTROL" />
            </intent-filter>
        </receiver>

        <receiver android:name=".VerifierReceiver"
            android:exported="true"
            android:directBootAware="true"
            android:permission="android.permission.BIND_PACKAGE_VERIFIER">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_NEEDS_VERIFICATION" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </receiver>

        <receiver android:name=".CommandReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="org.kioskclock.bridge.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
