{
  "_comment": "Applied once per fresh /data (first boot, factory reset) by ClockBridge. Bump 'version' to re-apply after an update. Every step is idempotent and logged.",
  "version": 6,
  "enable_components": [
    "me.jxl.kiosk_satellite/me.jxl.kiosk_satellite.HomeAlias"
  ],
  "input_method": "rkr.simplekeyboard.inputmethod/.latin.LatinIME",
  "accessibility_services": [
    "org.kioskclock.nav/org.kioskclock.nav.NavService"
  ],
  "disable_packages": [
    "com.android.browser",
    "com.android.calendar",
    "com.android.contacts",
    "com.android.music",
    "com.android.wallpaperpicker",
    "com.android.egg",
    "com.android.protips",
    "com.mediatek.bluetooth",
    "com.mesh.test.provisioner",
    "com.mediatek.ygps",
    "com.mediatek.autodialer",
    "com.mediatek.callrecorder",
    "com.google.android.marvin.talkback",
    "com.lenovo.mdm.admin.agent",
    "com.tonly.helios.ota",
    "com.mediatek.engineermode",
    "com.test.mtptest",
    "com.mediatek.duraspeed",
    "com.mediatek.location.lppe.main",
    "com.mediatek.gnss.nonframeworklbs",
    "com.android.printspooler",
    "com.android.bips",
    "com.android.printservice.recommendation",
    "com.android.cellbroadcastreceiver",
    "com.android.simappdialog",
    "com.android.ons",
    "com.android.mms.service",
    "com.android.calllogbackup",
    "com.android.emergency",
    "com.android.dreams.basic",
    "com.android.bookmarkprovider",
    "com.android.wallpaperbackup",
    "com.android.traceur",
    "com.android.providers.calendar",
    "com.google.android.tts",
    "com.android.musicfx",
    "com.android.htmlviewer",
    "com.android.providers.downloads.ui",
    "com.android.hotspot2",
    "com.android.bluetoothmidiservice",
    "com.android.companiondevicemanager"
  ],
  "bluetooth_name": "Smart Clock 2",
  "secure_settings": {
    "lockscreen.disabled": "1"
  },
  "system_settings": {
    "time_12_24": "24",
    "screen_off_timeout": "2147483647"
  },
  "global_settings": {
    "auto_time": "1",
    "stay_on_while_plugged_in": "7",
    "kioskclock_mic_indicator": "dot",
    "kioskclock_mic_color": "#D93025"
  },
  "time_zone": "Europe/Amsterdam",
  "grants": {
    "_comment": "Applied at every boot (idempotent): special access and runtime permissions, so no taps are needed.",
    "me.jxl.kiosk_satellite": {
      "appops": ["android:request_install_packages", "android:get_usage_stats", "android:write_settings", "android:system_alert_window"],
      "permissions": ["android.permission.READ_LOGS", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"]
    },
    "org.smarttube.stable": {
      "appops": [
        "android:request_install_packages"
      ]
    },
    "org.kioskclock.core": {
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "org.kioskclock.nav": {
      "permissions": ["android.permission.WRITE_SECURE_SETTINGS"]
    }
  },
  "buttons": {
    "_options": "alarm_snooze / alarm_stop (a ringing Kiosk Satellite alarm, like Lenovo's hard tap), voice (start Kiosk Satellite listening), play_pause (media), mute (speaker toggle), dock_light (toggle), night_light (toggle), screen_off (black screen), screen_toggle (black screen / wake), ha_event (only send it to Home Assistant), none. Every gesture is also sent to HA as an event.",
    "hold_volume_up": "voice",
    "hold_volume_down": "dock_light",
    "tap_single": "none",
    "tap_double": "none",
    "_alarm_taps": "While an alarm or timer rings, taps use kioskclock_alarm_tap_single / _double instead (default alarm_snooze / alarm_stop; a timer can't snooze, so snooze stops it)."
  }
}
